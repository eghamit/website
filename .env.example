# ---------------------------------------------------------------------------
# Price-Compare configuration
# Copy this file to `.env.local` and adjust as needed. All values are optional;
# the app ships with sensible defaults and runs out of the box.
# ---------------------------------------------------------------------------

# Comma-separated list of providers to enable.
# Available: myntra,ajio,meesho
ENABLED_PROVIDERS=myntra,ajio,meesho

# Data source for provider adapters:
#   dataset -> deterministic bundled catalog (default, runs offline)
#   live    -> real HTTP integration (requires per-provider credentials below)
PROVIDER_MODE=dataset

# Search result cache time-to-live in seconds.
SEARCH_CACHE_TTL_SECONDS=120

# Per-provider request timeout in milliseconds (used in `live` mode).
PROVIDER_TIMEOUT_MS=8000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Live integration credentials (only needed when PROVIDER_MODE=live).
# These are placeholders — wire them up inside lib/providers/<name>.ts.
# ---------------------------------------------------------------------------
# MYNTRA_API_BASE=
# MYNTRA_API_KEY=
# AJIO_API_BASE=
# AJIO_API_KEY=
# MEESHO_API_BASE=
# MEESHO_API_KEY=
